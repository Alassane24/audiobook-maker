# local.env.example - copy to `local.env` and edit. local.env is gitignored.
#
# Every setting resolves in this order:  local.env -> environment -> default.
# web/paths.py, the .bat launcher and the .vbs launcher all read this file, so
# Python, cmd and WScript agree on where things are.
#
# Run `python web/paths.py` to print what actually resolved and where each
# value came from.
#
# NOTHING here is required. With no local.env at all the repo assumes a
# self-contained checkout on loopback.

# --- where the server listens ----------------------------------------------
# Default is loopback. The original install binds a Tailscale IP on purpose so
# the app is reachable from a phone WITHOUT being exposed to the local Wi-Fi.
# If you set this to a LAN address, understand you are publishing the app to
# every device on that network.
#AUDIOBOOK_HOST=127.0.0.1
#AUDIOBOOK_PORT=8765

# --- where things get written -----------------------------------------------
# Finished .m4b files. Default is <repo>/out/audiobooks.
#AUDIOBOOK_TRANSFER_DIR=D:\path\to\audiobooks
# Per-job working dirs. Default is <repo>/web/jobs.
#AUDIOBOOK_JOBS_DIR=
# Source pages and voice previews. Default is <repo>/samples.
#AUDIOBOOK_SAMPLES_DIR=

# --- external tools ----------------------------------------------------------
# Prepended to PATH by the .bat launcher. Leave unset if ffmpeg is already on
# PATH, which is what the README asks for.
#AUDIOBOOK_FFMPEG_DIR=C:\path\to\ffmpeg\bin
# Tesseract language data (needs eng + jpn). Default is <repo>/tessdata; if that
# does not exist, Tesseract's own install is used. See README setup step 2.
#AUDIOBOOK_TESSDATA=

# --- launcher ----------------------------------------------------------------
# Interpreter the .bat starts uvicorn with. Default is <repo>/.venv.
#AUDIOBOOK_PYTHON=
# Chrome profile for the app window. Default is <repo>/.chrome-profile.
#AUDIOBOOK_CHROME_PROFILE=
